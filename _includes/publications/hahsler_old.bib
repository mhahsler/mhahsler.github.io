@ARTICLE{hahsler:GeyerSchulz1999,
  author = {Andreas Geyer-Schulz and Michael Hahsler and Georg Schneider},
  title = {The Virtual University and Its Embedded Agents},
  journal = {{\"O}{G}{A}{I}{} Journal},
  year = {1999},
  volume = {18},
