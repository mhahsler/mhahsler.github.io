\section{lapply, sapply, apply}
\begin{frame}[containsverbatim,shrink]
\frametitle{lapply/sapply -- apply functions to each element in a lists}
<<>>=
l <- list(1:3, 6, 7:3)
# apply rev to all elements
lapply(l, FUN=function(x) { rev(x) }) 
# apply length + "simplify"
sapply(l, length)		      
@
\end{frame}

\begin{frame}[containsverbatim,shrink]
\frametitle{apply -- apply functions to a matrix}
<<>>=
m <- matrix(1:9, nrow=3)
apply(m, MARGIN=1, sum)	    # apply sum to rows
apply(m, MARGIN=2, sum)	    # apply sum to cols
# same as
rowSums(m); colSums(m)
@
\end{frame}

\section{Exercises}
\begin{frame}[containsverbatim, shrink]
\frametitle{Exercises}
\begin{enumerate}
\item Create x by \code{x <- runif(100)}. Write a function with the name 
    \code{avg\_gt} with two formal arguments: a vector x and a value gt.
    The functions computes the average of the values greater than gt in x.
    Write a version with a loop and if and one version without loops and if 
    statements.  

\item Create a list with 5 numeric vectors (lengths and values
    of your choice). Sort all vectors in the list. Hint: see \code{sort()}.

\item Write a function which computes the smallest value in each column of
    a given matrix.  Create a random $5\times5$ matrix to test the function.
\end{enumerate}
\end{frame}



