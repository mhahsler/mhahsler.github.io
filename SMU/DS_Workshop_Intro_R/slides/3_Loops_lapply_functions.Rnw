\section{Conditional Statements}

\begin{frame}[containsverbatim,shrink]
\frametitle{if}
\small
<<>>=
x <- 12
if(x>10) {	    # result of condition needs length 1
    cat("x is >10") 
} else { 
    cat("x is <=10") 
}

x <- c(12, 16, 3)
if(all(x>10)) cat("All values in x are >10")
if(any(x>10)) cat("There is at least one value >10")   

c(FALSE,TRUE,TRUE) | c(FALSE,TRUE,FALSE) # element-wise OR (see &)
c(FALSE,TRUE,TRUE) || c(FALSE,TRUE,FALSE) # only eval. the 1. elements
@
%\begin{block}{}
%\end{block}
\end{frame}

\section{Loops}

\begin{frame}[containsverbatim,shrink]
\frametitle{for}
\small
<<>>=
# calculate the sum of the integers 1 to 5
x <- 0
for(i in 1:5) {
    x <- x+i
}
x

# in R we would do
sum(1:5)

# we can also use lists (R recycles values!)
l <- list(a=2, b=1:2, c=4)
x <- 0; for(i in l) { x <- x+i }
x
@
%\begin{block}{}
%\end{block}
\end{frame}

\begin{frame}[containsverbatim,shrink]
\frametitle{while}
\small
<<>>=
# calculate the sum of the integers 1 to 5
x <- 0
i <- 1
while(i <=5) { x <- x+i; i<-i+1 }
x

@
\begin{block}{}
\code{break} and \code{next} work as expected.\\
Note: Loops are not very frequently used in R since most problems can be 
solved more efficiently using functions  and vectorization.
\end{block}
\end{frame}

\section{Functions}
\begin{frame}[containsverbatim,shrink]
\frametitle{Functions}
\small
R is a functional programming language. 
Functions are objects of mode ``function''.

<<>>=
inc <- function(x) { x+1 } 
inc
mode(inc)

inc(5)
inc(1:10)
@

\begin{block}{}
Since functions are regular (first class) objects they can be passed
on as arguments and returned by functions.
\end{block}
\end{frame}

\begin{frame}[containsverbatim,shrink]
\frametitle{Named arguments and defaults}
\small

<<>>=
inc <- function(x, by = 1) { x + by } 

inc(5)			# using a default value
inc(1:5, 10)		# using order
inc(1:5, by=10)		# using order+names
inc(by=10, x=1:5)	# using names
inc(matrix(1:4, nrow=2), 10)
@

\begin{block}{}
Functions return the
value of the last expression (or use \code{return(val)}).
\end{block}
\end{frame}


